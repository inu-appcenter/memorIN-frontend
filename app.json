{
  "expo": {
    "name": "memorIN",
    "slug": "memorIN",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/memorIN_ios.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "memorIN",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/memorIN_android_adaptive.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.anonymous.memorIN"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-video",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1747BB",
          "image": "./assets/memorIN_splash_icon_text.png",
          "imageWidth": 130,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "allowBackup": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "사진/동영상 접근 권한이 필요합니다."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-localization"
    ]
  }
}

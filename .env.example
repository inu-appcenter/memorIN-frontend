# 로컬 백엔드(bootRun) 기본 포트: 8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# 로컬 백엔드(bootRun) 기본 포트: 8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Web Push VAPID 공개키
#
# 백엔드의 WEB_PUSH_VAPID_PUBLIC_KEY와 반드시 같은 값이어야 한다. 다르면
# 브라우저가 구독은 만들지만 백엔드 서명과 맞지 않아 발송이 403으로 실패한다.
#
# 키 쌍 생성 방법:
#   터미널에서 npx web-push generate-vapid-keys 실행
#
# 프론트 .env에는 공개키,백엔드 .env에는 공개키와 개인키 모두 넣는다.
#
# 아래에 생성한 공개키 입력
EXPO_PUBLIC_VAPID_PUBLIC_KEY= 